{
  "name": "umg/iot-led",
  "description": "API del sistema IoT de mensajes en matriz LED 8x8",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-mongodb": "*",
    "mongodb/mongodb": "^2.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
